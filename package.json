{
  "name": "fieldnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal AI assistant powered by SQLite, Algolia NeuralSearch, and Agent Studio.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NatanTechofNY/fieldnote-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/NatanTechofNY/fieldnote-assistant/issues"
  },
  "homepage": "https://github.com/NatanTechofNY/fieldnote-assistant#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "concurrently -n web,api -c cyan,yellow --success all \"npm:test:web\" \"npm:test:server\"",
    "test:web": "vitest run tests/app.test.tsx",
    "test:server": "node --experimental-strip-types --test tests/server-api.test.ts",
    "test:coverage": "concurrently -n web,api -c cyan,yellow --success all \"npm:test:coverage:web\" \"npm:test:coverage:server\"",
    "test:coverage:web": "vitest run tests/app.test.tsx --coverage",
    "test:coverage:server": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-lines=92 --test-coverage-branches=73 --test-coverage-functions=92 tests/server-api.test.ts",
    "test:watch": "concurrently -n web,api -c cyan,yellow \"vitest\" \"node --experimental-strip-types --test --watch tests/server-api.test.ts\"",
    "seed": "tsx server/index.ts --seed",
    "reset": "tsx server/index.ts --reset",
    "reindex": "tsx server/index.ts --reindex",
    "setup:algolia": "tsx server/index.ts --setup-algolia"
  },
  "keywords": [
    "algolia",
    "neural-search",
    "agent-studio",
    "personal-assistant"
  ],
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.101.3",
    "algoliasearch": "^5.56.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "instantsearch.css": "^8.18.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-instantsearch": "^7.39.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "remark-breaks": "^4.0.0",
    "tsx": "^4.23.1",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
