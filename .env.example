# Local server
PORT=4174
DATABASE_PATH=./data/assistant.db
DEMO_USER_ID=devcon-demo
SETTINGS_ENCRYPTION_KEY=
# Sign-in password. Required in production; the server refuses to start without it.
APP_ADMIN_PASSWORD=
# Escape hatch to run in production with no authentication at all. Rarely correct.
APP_ALLOW_NO_AUTH=false
# Development only; never enable in production
TWILIO_SKIP_SIGNATURE_VALIDATION=false
SENDBLUE_SKIP_SIGNATURE_VALIDATION=false
# Only needed to point Sendblue calls somewhere other than https://api.sendblue.co
SENDBLUE_API_BASE_URL=
# Comma-separated tunnel hostnames allowed by the Vite dev server
VITE_ALLOWED_HOSTS=
# Only needed when the UI is served from a different origin than the API
CORS_ORIGIN=

# Algolia Search and NeuralSearch
ALGOLIA_APPLICATION_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_TODO_INDEX=devcon_assistant_todos
ALGOLIA_MEMORY_INDEX=devcon_assistant_memories
ALGOLIA_MESSAGE_INDEX=devcon_assistant_messages
# NeuralSearch is a paid add-on. This only sets the initial value for a fresh
# database; after that the toggle in Settings > Under the hood owns it.
ALGOLIA_NEURAL_SEARCH=false

# Published Agent Studio agent
ALGOLIA_AGENT_ID=
ALGOLIA_AGENT_API_KEY=

# Optional browser-safe values for direct Agent Studio UI integration
VITE_ALGOLIA_APPLICATION_ID=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_AGENT_ID=
VITE_ALGOLIA_TODO_INDEX=devcon_assistant_todos
